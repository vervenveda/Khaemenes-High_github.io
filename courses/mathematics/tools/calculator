<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Khaemenes Scientific Calculator v4 — safe offline scientific computation with correct precedence, calculator-style percentages, degree and radian modes, memory, history, live preview, backup, and keyboard support.">
<meta name="theme-color" content="#11151c">
<title>Khaemenes Scientific Calculator v4</title>
<style>
:root{
  --bg:#0e1117;--bg2:#151a22;--panel:#202630;--panel2:#2a313d;--screen:#090c11;
  --ink:#f4f6f8;--muted:#9ca7b4;--gold:#c9b06b;--gold2:#e2ca8b;--blue:#58697f;
  --danger:#9f4652;--good:#60c48f;--line:rgba(255,255,255,.09);
  --shadow:0 24px 70px rgba(0,0,0,.48)
}
html[data-theme="light"]{
  --bg:#e9e5dc;--bg2:#f3efe7;--panel:#fbfaf6;--panel2:#eee8dc;--screen:#fff;
  --ink:#17232d;--muted:#697581;--blue:#cbd6e1;--line:rgba(23,35,45,.12);
  --shadow:0 24px 65px rgba(48,41,31,.18)
}
*{box-sizing:border-box}
html{color-scheme:dark}
html[data-theme="light"]{color-scheme:light}
body{
  margin:0;min-height:100vh;padding:18px 10px 42px;color:var(--ink);
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:
    radial-gradient(circle at 15% 8%,rgba(201,176,107,.08),transparent 24%),
    linear-gradient(145deg,var(--bg),var(--bg2))
}
button,input,select{font:inherit}
button{cursor:pointer;touch-action:manipulation}
button:disabled{cursor:not-allowed;opacity:.45}
:focus-visible{outline:3px solid rgba(201,176,107,.38);outline-offset:3px}
.app-shell{width:min(1180px,100%);margin:auto}
.site-head{
  display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px;
  padding:11px 13px;border:1px solid var(--line);border-radius:17px;
  background:rgba(32,38,48,.76);backdrop-filter:blur(14px)
}
html[data-theme="light"] .site-head{background:rgba(251,250,246,.84)}
.brand{display:flex;align-items:center;gap:11px;min-width:0}
.brand-mark{
  width:48px;height:48px;display:grid;place-items:center;border:1px solid rgba(201,176,107,.55);
  border-radius:13px;color:var(--gold2);font-family:Georgia,serif;letter-spacing:.08em
}
.brand-copy strong{
  display:block;font-family:Georgia,serif;font-size:1rem;letter-spacing:.06em;text-transform:uppercase
}
.brand-copy small{display:block;margin-top:2px;color:var(--muted);font-size:.72rem}
.head-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.icon-btn{
  min-height:40px;padding:8px 11px;border:1px solid var(--line);border-radius:11px;
  background:var(--panel);color:var(--ink);font-weight:800
}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:14px;align-items:start}
.calc,.drawer{
  border:1px solid var(--line);border-radius:21px;
  background:linear-gradient(145deg,var(--panel),var(--panel2));box-shadow:var(--shadow)
}
.calc{min-width:0;padding:17px}
.drawer{position:sticky;top:18px;padding:15px}
.top{
  display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:28px;
  color:var(--gold2);font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase
}
.status-group{display:flex;gap:10px;flex-wrap:wrap}
.status-chip{display:inline-flex;align-items:center;gap:5px}
.status-dot{width:7px;height:7px;border-radius:50%;background:var(--muted)}
.status-dot.on{background:var(--gold)}
.screen{
  min-height:165px;margin:10px 0 13px;padding:14px;border:1px solid rgba(201,176,107,.22);
  border-radius:16px;background:var(--screen);overflow:hidden
}
#expr{
  min-height:31px;color:var(--muted);text-align:right;font:1rem/1.45 Consolas,monospace;
  white-space:nowrap;overflow-x:auto;overflow-y:hidden;scrollbar-width:thin
}
#disp{
  min-height:60px;margin-top:5px;text-align:right;font-family:Consolas,monospace;
  font-size:clamp(2.25rem,7vw,4.35rem);line-height:1.1;letter-spacing:-.045em;
  overflow-wrap:anywhere
}
.preview-note{
  min-height:1.2em;margin-top:3px;color:var(--muted);text-align:right;font-size:.68rem
}
.screen-meta{
  display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:11px;
  color:var(--muted);font-size:.7rem
}
.screen-message{min-height:1.2em;color:var(--gold2);line-height:1.35}
.screen-message.error{color:#ff9ba6}
.copy-result,.clear-history,.drawer-action{
  border:0;background:transparent;color:var(--muted);font-size:.7rem
}
.mobile-expression{
  display:none;width:100%;margin-bottom:10px;padding:11px 12px;border:1px solid var(--line);
  border-radius:12px;background:var(--screen);color:var(--ink)
}
.grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}
.key{
  position:relative;min-width:0;height:56px;padding:7px 5px;border:1px solid rgba(255,255,255,.035);
  border-radius:12px;background:#343b46;color:#fff;font-size:1rem;font-weight:760;
  box-shadow:inset 0 1px rgba(255,255,255,.05),0 3px 8px rgba(0,0,0,.16);
  transition:transform .1s,filter .1s
}
html[data-theme="light"] .key{border-color:rgba(23,35,45,.09);background:#f5f2ec;color:#17232d}
.key:hover{filter:brightness(1.08)}
.key:active,.key.pressed{transform:translateY(2px) scale(.985)}
.key small{position:absolute;top:4px;left:6px;color:#d6c58f;font-size:.53rem}
.key.function{background:#2b333e}
.key.operator{background:var(--blue)}
.key.control{background:#4a3f46}
.key.memory{background:#2f363f;color:#e5d49d}
.key.equals{background:linear-gradient(145deg,var(--gold2),var(--gold));color:#141414;font-weight:950}
.key.danger{background:var(--danger)}
.key.zero{grid-column:span 2}
.secondary-strip{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:8px}
.secondary-strip .key{height:46px;font-size:.82rem}
.drawer-head{
  display:flex;justify-content:space-between;align-items:center;gap:8px;padding-bottom:11px;
  border-bottom:1px solid var(--line)
}
.drawer h2{margin:0;color:var(--gold2);font-family:Georgia,serif;font-size:1.08rem}
.drawer-actions{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}
.drawer-action{
  padding:5px 7px;border:1px solid var(--line);border-radius:8px;background:transparent
}
.drawer-close{display:none}
.history{display:grid;gap:8px;max-height:430px;margin-top:11px;overflow:auto}
.history-item{padding:10px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.025)}
.history-expression{color:var(--muted);font:.72rem/1.4 Consolas,monospace;overflow-wrap:anywhere}
.history-result{margin-top:4px;font:800 1rem Consolas,monospace;overflow-wrap:anywhere}
.history-time{margin-top:4px;color:var(--muted);font-size:.62rem}
.history-actions{display:flex;gap:6px;margin-top:7px}
.history-actions button{
  flex:1;padding:6px;border:1px solid var(--line);border-radius:8px;background:transparent;
  color:var(--muted);font-size:.68rem
}
.history-empty{padding:22px 8px;color:var(--muted);text-align:center;font-size:.8rem;line-height:1.5}
.help{margin-top:13px;padding-top:13px;border-top:1px solid var(--line)}
.help summary{cursor:pointer;color:var(--gold2);font-size:.82rem;font-weight:850}
.help-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}
.help-grid div{
  padding:8px;border-radius:9px;background:rgba(255,255,255,.025);
  color:var(--muted);font-size:.68rem;line-height:1.45
}
.backup-row{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}
.backup-row button{
  padding:8px;border:1px solid var(--line);border-radius:9px;background:transparent;
  color:var(--muted);font-size:.7rem
}
.footer-note{margin-top:13px;color:var(--muted);text-align:center;font-size:.72rem;line-height:1.5}
.toast{
  position:fixed;left:50%;bottom:20px;z-index:50;transform:translate(-50%,26px);
  padding:9px 14px;border-radius:999px;background:#07090c;color:#fff;
  font-size:.78rem;font-weight:800;opacity:0;pointer-events:none;transition:.2s
}
.toast.show{opacity:1;transform:translate(-50%,0)}
.drawer-overlay{display:none}
@media(max-width:900px){
  .layout{grid-template-columns:1fr}
  .drawer{
    position:fixed;z-index:40;top:10px;right:10px;bottom:10px;width:min(360px,calc(100vw - 20px));
    overflow:auto;transform:translateX(calc(100% + 24px));transition:transform .2s ease
  }
  body.drawer-open{overflow:hidden}
  body.drawer-open .drawer{transform:translateX(0)}
  .drawer-overlay{
    display:block;position:fixed;z-index:35;inset:0;background:rgba(0,0,0,.48);
    opacity:0;pointer-events:none;transition:opacity .2s
  }
  body.drawer-open .drawer-overlay{opacity:1;pointer-events:auto}
  .drawer-close{display:inline-flex}
}
@media(max-width:620px){
  body{padding:8px 5px 28px}.calc{padding:10px;border-radius:15px}
  .grid,.secondary-strip{gap:5px}.key{height:50px;border-radius:9px;font-size:.9rem}
  .secondary-strip .key{height:43px}.mobile-expression{display:block}.top{font-size:.6rem}
  .brand-copy small{display:none}.screen{min-height:150px}
}
@media(max-width:430px){
  .brand-copy strong{font-size:.78rem}.brand-mark{width:42px;height:42px}
  .head-actions .icon-btn[data-optional="true"]{display:none}
  .key{height:48px;font-size:.82rem}.key small{display:none}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{scroll-behavior:auto!important;transition:none!important}
}
</style>
</head>
<body>
<div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>
<div class="app-shell">
  <header class="site-head">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true">KA</div>
      <div class="brand-copy">
        <strong>Khaemenes Scientific Calculator</strong>
        <small>Verve N Veda Tools · Safe local computation · Version 4</small>
      </div>
    </div>
    <div class="head-actions">
      <button class="icon-btn" id="historyToggle" aria-controls="historyDrawer" aria-expanded="false">History</button>
      <button class="icon-btn" id="hapticBtn" data-optional="true">Haptic On</button>
      <button class="icon-btn" id="themeBtn">Light</button>
    </div>
  </header>

  <main class="layout">
    <section class="calc" aria-label="Scientific calculator">
      <div class="top">
        <div class="status-group">
          <span class="status-chip"><span class="status-dot on"></span><span id="angleStatus">DEG</span></span>
          <span class="status-chip"><span class="status-dot" id="memoryDot"></span>M</span>
          <span class="status-chip"><span class="status-dot" id="shiftDot"></span>SHIFT</span>
          <span class="status-chip"><span id="parenStatus">PAREN 0</span></span>
        </div>
        <span>12-Digit Precision</span>
      </div>

      <div class="screen" aria-live="polite">
        <div id="expr" aria-label="Current expression"></div>
        <div id="disp">0</div>
        <div class="preview-note" id="previewNote"></div>
        <div class="screen-meta">
          <span class="screen-message" id="message"></span>
          <button class="copy-result" id="copyBtn">Copy result</button>
        </div>
      </div>

      <input
        class="mobile-expression"
        id="expressionInput"
        autocomplete="off"
        spellcheck="false"
        inputmode="text"
        aria-label="Calculator expression"
        placeholder="Type an expression"
      >

      <div class="grid" id="keys"></div>
      <div class="secondary-strip" id="secondaryKeys"></div>

      <div class="footer-note">
        Keyboard: numbers/operators · Enter evaluates · Backspace deletes · Escape clears expression · D toggles DEG/RAD
      </div>
    </section>

    <aside class="drawer" id="historyDrawer" aria-label="Calculation history">
      <div class="drawer-head">
        <h2>Calculation History</h2>
        <div class="drawer-actions">
          <button class="drawer-action" id="exportBtn">Export</button>
          <button class="drawer-action" id="importBtn">Import</button>
          <button class="drawer-action clear-history" id="clearHistoryBtn">Clear</button>
          <button class="drawer-action drawer-close" id="drawerCloseBtn" aria-label="Close history">Close</button>
        </div>
      </div>

      <div class="history" id="historyList"></div>

      <details class="help">
        <summary>Functions and keyboard help</summary>
        <div class="help-grid">
          <div><strong>Angles</strong><br>DEG or RAD affects trigonometry.</div>
          <div><strong>Percent</strong><br>200 + 10% becomes 220.</div>
          <div><strong>Constants</strong><br>π, e, Ans, random, and memory.</div>
          <div><strong>Precedence</strong><br>−2² is −4; (−2)² is 4.</div>
          <div><strong>Clear</strong><br>AC clears the expression but keeps Ans.</div>
          <div><strong>Safety</strong><br>No eval or Function execution.</div>
        </div>
        <div class="backup-row">
          <button id="resetAllBtn">Reset calculator data</button>
          <button id="copyHistoryBtn">Copy history text</button>
        </div>
      </details>
    </aside>
  </main>
</div>

<input type="file" id="importFile" accept="application/json,.json" hidden>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(() => {
"use strict";

const $ = id => document.getElementById(id);
const STORAGE_KEY = "khaemenes-scientific-calculator-v4";
const HISTORY_LIMIT = 60;

const PRIMARY = [
  ["MC","MR","MS","M+","M-","AC"],
  ["(",")","⌫","÷","√","^"],
  ["7","8","9","×","π","Ans"],
  ["4","5","6","−","x²","%"],
  ["1","2","3","+","±","="],
  ["0",".","EXP","sin","cos","tan"]
];

const SECONDARY = ["SHIFT","DEG/RAD","ln","log","e","!","asin","acos","atan","1/x","|x|","rand"];

const SHIFT = {
  "sin":"asin","cos":"acos","tan":"atan","√":"∛","x²":"x³","ln":"eˣ","log":"10ˣ"
};

const LABELS = {
  "MC":"Clear memory","MR":"Recall memory","MS":"Store displayed value in memory",
  "M+":"Add displayed value to memory","M-":"Subtract displayed value from memory",
  "AC":"Clear expression","(":"Open parenthesis",")":"Close parenthesis","⌫":"Backspace",
  "÷":"Divide","√":"Square root","^":"Raise to a power","×":"Multiply","π":"Pi",
  "Ans":"Previous answer","−":"Subtract","x²":"Square","%":"Percent","+":"Add",
  "±":"Change the sign of the active value","=":"Evaluate","EXP":"Enter scientific notation exponent",
  "sin":"Sine","cos":"Cosine","tan":"Tangent","SHIFT":"Toggle alternate functions",
  "DEG/RAD":"Toggle degree and radian modes","ln":"Natural logarithm","log":"Base ten logarithm",
  "e":"Euler's number","!":"Factorial","asin":"Inverse sine","acos":"Inverse cosine",
  "atan":"Inverse tangent","1/x":"Reciprocal","|x|":"Absolute value","rand":"Random number",
  "∛":"Cube root","x³":"Cube","eˣ":"E to the power x","10ˣ":"Ten to the power x"
};

function fresh(){
  return {
    expression:"",
    answer:0,
    memory:0,
    angleMode:"DEG",
    shift:false,
    history:[],
    theme:"dark",
    haptic:true,
    lastExpression:"",
    justEvaluated:false
  };
}

function sanitizeState(raw){
  const base = fresh();
  if(!raw || typeof raw !== "object") return base;
  return {
    expression:typeof raw.expression === "string" ? raw.expression.slice(0,5000) : "",
    answer:Number.isFinite(Number(raw.answer)) ? Number(raw.answer) : 0,
    memory:Number.isFinite(Number(raw.memory)) ? Number(raw.memory) : 0,
    angleMode:raw.angleMode === "RAD" ? "RAD" : "DEG",
    shift:!!raw.shift,
    history:Array.isArray(raw.history)
      ? raw.history.slice(0,HISTORY_LIMIT).filter(x=>x && typeof x.expression==="string" && typeof x.result==="string")
      : [],
    theme:raw.theme === "light" ? "light" : "dark",
    haptic:raw.haptic !== false,
    lastExpression:typeof raw.lastExpression === "string" ? raw.lastExpression.slice(0,5000) : "",
    justEvaluated:!!raw.justEvaluated
  };
}

function load(){
  try{
    return sanitizeState(JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"));
  }catch{
    return fresh();
  }
}

let state = load();
let previewCache = {ok:false,value:0,error:null};
let renderQueued = false;

function save(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }catch{}
}

function toast(text){
  $("toast").textContent = text;
  $("toast").classList.add("show");
  clearTimeout(toast.timer);
  toast.timer = setTimeout(()=>$("toast").classList.remove("show"), 1600);
}

function vibrate(pattern=8){
  if(state.haptic && navigator.vibrate){
    try{ navigator.vibrate(pattern); }catch{}
  }
}

function fmt(value){
  if(!Number.isFinite(value)) return String(value);
  if(Object.is(value,-0)) value = 0;
  const abs = Math.abs(value);
  if((abs && abs < 1e-9) || abs >= 1e12){
    return value.toExponential(10).replace(/\.?0+e/,"e");
  }
  return Number(value.toPrecision(12)).toString();
}

function pretty(source){
  return String(source)
    .replaceAll("*","×")
    .replaceAll("/","÷")
    .replaceAll("-","−")
    .replace(/\bpi\b/g,"π")
    .replace(/\bmem\b/g,"M")
    .replace(/\bsqrt\b/g,"√")
    .replace(/\bcbrt\b/g,"∛")
    .replace(/\bpow10\b/g,"10ˣ")
    .replace(/\breciprocal\b/g,"1/x")
    .replace(/\babs\b/g,"|x|");
}

function setMessage(text="",type="",ms=0){
  const el = $("message");
  el.textContent = text;
  el.classList.toggle("error", type === "error");
  clearTimeout(setMessage.timer);
  if(ms){
    setMessage.timer = setTimeout(()=>{
      el.textContent = "";
      el.classList.remove("error");
    },ms);
  }
}

function rad(x){ return state.angleMode === "DEG" ? x * Math.PI / 180 : x; }
function unrad(x){ return state.angleMode === "DEG" ? x * 180 / Math.PI : x; }

function factorial(n){
  if(!Number.isInteger(n) || n < 0) throw new CalcError("Factorial needs a non-negative integer");
  if(n > 170) throw new CalcError("Factorial is too large");
  let result = 1;
  for(let i=2;i<=n;i++) result *= i;
  return result;
}

class CalcError extends Error{
  constructor(message,pos=null){
    super(message);
    this.name = "CalcError";
    this.pos = Number.isInteger(pos) ? pos : null;
  }
}

const FUNCTIONS = {
  sin:x=>Math.sin(rad(x)),
  cos:x=>Math.cos(rad(x)),
  tan:x=>{
    const r = rad(x);
    if(Math.abs(Math.cos(r)) < 1e-14) throw new CalcError("Tangent is undefined at this angle");
    return Math.tan(r);
  },
  asin:x=>{
    if(x < -1 || x > 1) throw new CalcError("asin requires a value from −1 to 1");
    return unrad(Math.asin(x));
  },
  acos:x=>{
    if(x < -1 || x > 1) throw new CalcError("acos requires a value from −1 to 1");
    return unrad(Math.acos(x));
  },
  atan:x=>unrad(Math.atan(x)),
  sqrt:x=>{
    if(x < 0) throw new CalcError("Square root needs a non-negative number");
    return Math.sqrt(x);
  },
  cbrt:x=>Math.cbrt(x),
  ln:x=>{
    if(x <= 0) throw new CalcError("Natural log needs a positive number");
    return Math.log(x);
  },
  log:x=>{
    if(x <= 0) throw new CalcError("Log needs a positive number");
    return Math.log10(x);
  },
  abs:x=>Math.abs(x),
  exp:x=>{
    const value = Math.exp(x);
    if(!Number.isFinite(value)) throw new CalcError("Exponential result is too large");
    return value;
  },
  pow10:x=>{
    const value = 10 ** x;
    if(!Number.isFinite(value)) throw new CalcError("Power-of-ten result is too large");
    return value;
  },
  reciprocal:x=>{
    if(x === 0) throw new CalcError("Cannot divide by zero");
    return 1/x;
  }
};

function valueOf(number,percent=false){ return {number,percent}; }

function tokenize(input){
  const tokens = [];
  let i = 0;

  while(i < input.length){
    const char = input[i];

    if(/\s/.test(char)){ i++; continue; }

    if(/[0-9.]/.test(char)){
      const start = i;
      let number = "";
      let dots = 0;

      while(i < input.length && /[0-9.eE+-]/.test(input[i])){
        const current = input[i];
        if(current === "."){
          dots++;
          if(dots > 1) break;
        }
        if((current === "+" || current === "-") && !/[eE]$/.test(number)) break;
        number += current;
        i++;
      }

      if(!/^(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?$/.test(number)){
        throw new CalcError("Invalid number",start);
      }

      tokens.push({type:"number",value:Number(number),pos:start});
      continue;
    }

    if(/[A-Za-z_π]/.test(char)){
      const start = i;
      let word = "";
      if(char === "π"){
        word = "pi";
        i++;
      }else{
        while(i < input.length && /[A-Za-z_0-9]/.test(input[i])){
          word += input[i++];
        }
      }
      tokens.push({type:"word",value:word.toLowerCase(),pos:start});
      continue;
    }

    if("+-*/^(),%!".includes(char)){
      tokens.push({type:"symbol",value:char,pos:i});
      i++;
      continue;
    }

    throw new CalcError("Unsupported character: " + char,i);
  }

  return tokens;
}

function parseExpression(input,{allowRandom=true}={}){
  const tokens = tokenize(input);
  let pointer = 0;

  const current = () => tokens[pointer];
  const peek = value => current() && (value === undefined || current().value === value);
  const take = value => {
    const token = current();
    if(!token || (value !== undefined && token.value !== value)){
      throw new CalcError(value ? "Expected " + value : "Incomplete expression",token ? token.pos : input.length);
    }
    pointer++;
    return token;
  };

  function postfix(){
    let result = primary();
    while(peek("!") || peek("%")){
      if(peek("!")){
        take("!");
        result = valueOf(factorial(result.number),false);
      }else{
        take("%");
        result = valueOf(result.number / 100,true);
      }
    }
    return result;
  }

  function power(){
    let left = postfix();
    if(peek("^")){
      take("^");
      const right = unary();
      left = valueOf(Math.pow(left.number,right.number),false);
    }
    return left;
  }

  function unary(){
    if(peek("+")){
      take("+");
      return unary();
    }
    if(peek("-")){
      take("-");
      const result = unary();
      return valueOf(-result.number,result.percent);
    }
    return power();
  }

  function beginsImplicitMultiplication(){
    const token = current();
    return !!token && (token.type === "word" || token.value === "(");
  }

  function multiply(){
    let left = unary();

    for(;;){
      if(peek("*")){
        take("*");
        left = valueOf(left.number * unary().number,false);
      }else if(peek("/")){
        take("/");
        const divisor = unary().number;
        if(divisor === 0) throw new CalcError("Cannot divide by zero",current() ? current().pos : input.length);
        left = valueOf(left.number / divisor,false);
      }else if(beginsImplicitMultiplication()){
        left = valueOf(left.number * unary().number,false);
      }else{
        break;
      }
    }

    return left;
  }

  function add(){
    let left = multiply();

    while(peek("+") || peek("-")){
      const operator = take().value;
      const right = multiply();

      if(right.percent){
        const adjustment = left.number * right.number;
        left = valueOf(operator === "+" ? left.number + adjustment : left.number - adjustment,false);
      }else{
        left = valueOf(operator === "+" ? left.number + right.number : left.number - right.number,false);
      }
    }

    return left;
  }

  function primary(){
    if(peek("(")){
      take("(");
      const result = add();
      take(")");
      return result;
    }

    const token = current();
    if(!token) throw new CalcError("Incomplete expression",input.length);

    if(token.type === "number"){
      pointer++;
      return valueOf(token.value,false);
    }

    if(token.type === "word"){
      pointer++;
      const name = token.value;

      if(name === "pi") return valueOf(Math.PI,false);
      if(name === "e") return valueOf(Math.E,false);
      if(name === "ans") return valueOf(Number(state.answer) || 0,false);
      if(name === "mem") return valueOf(Number(state.memory) || 0,false);

      if(name === "rand"){
        if(!allowRandom) throw new CalcError("Press = to generate a random value",token.pos);
        return valueOf(Math.random(),false);
      }

      if(FUNCTIONS[name]){
        take("(");
        const argument = add();
        take(")");
        return valueOf(FUNCTIONS[name](argument.number),false);
      }

      throw new CalcError("Unknown function: " + name,token.pos);
    }

    throw new CalcError("Expected a number or function",token.pos);
  }

  const result = add();
  if(pointer < tokens.length){
    throw new CalcError("Unexpected token: " + tokens[pointer].value,tokens[pointer].pos);
  }
  if(!Number.isFinite(result.number)){
    throw new CalcError("Result is outside calculator range");
  }
  return result.number;
}

function normalize(source){
  return String(source)
    .replaceAll("×","*")
    .replaceAll("÷","/")
    .replaceAll("−","-")
    .replaceAll("π","pi")
    .replaceAll("√","sqrt")
    .replaceAll("∛","cbrt");
}

function calculateValue(expression,{allowRandom=true}={}){
  const source = normalize(String(expression).trim());
  if(!source) return Number(state.answer) || 0;
  return parseExpression(source,{allowRandom});
}

function formatError(error){
  if(error instanceof CalcError && error.pos !== null){
    return `${error.message} near character ${error.pos + 1}`;
  }
  return error && error.message ? error.message : "Invalid expression";
}

function evaluate(expression=state.expression,{history=true}={}){
  const original = String(expression).trim();
  if(!original) return Number(state.answer) || 0;

  try{
    const result = calculateValue(original,{allowRandom:true});
    state.answer = result;
    state.lastExpression = original;
    state.expression = fmt(result);
    state.justEvaluated = true;

    if(history){
      state.history.unshift({
        expression:original,
        result:fmt(result),
        time:new Date().toISOString()
      });
      state.history = state.history.slice(0,HISTORY_LIMIT);
    }

    setMessage("Calculated","",1200);
    render();
    return result;
  }catch(error){
    setMessage(formatError(error),"error",3200);
    $("disp").textContent = "Error";
    vibrate([16,30,16]);
    return null;
  }
}

function isOperator(value){ return ["+","-","*","/","^"].includes(value); }

function prepareForInput(value){
  if(!state.justEvaluated) return;

  const continueFromAnswer =
    isOperator(value) || value === "%" || value === "!" || value === ")" || value === "^";

  state.expression = continueFromAnswer ? fmt(state.answer) : "";
  state.lastExpression = "";
  state.justEvaluated = false;
}

function append(value){
  prepareForInput(value);
  let expression = state.expression;
  const last = expression.slice(-1);

  if(isOperator(value)){
    if(!expression){
      if(value === "-") state.expression = "-";
      render();
      return;
    }

    if(isOperator(last)){
      if(value === "-" && last !== "-"){
        state.expression += "-";
      }else{
        state.expression = expression.slice(0,-1) + value;
      }
      render();
      return;
    }
  }

  if(value === "."){
    const tail = expression.split(/[+\-*/^()]/).pop() || "";
    if(tail.includes(".") && !/[eE]/.test(tail)) return;
    if(!tail || /[eE][+-]?$/.test(tail)) value = "0.";
  }

  if(value === ")"){
    const balance = parenthesisBalance(expression);
    if(balance <= 0 || !expression || isOperator(last) || last === "(") return;
  }

  if((value === "%" || value === "!") && (!expression || isOperator(last) || last === "(")) return;

  state.expression += value;
  render();
}

function appendExponent(){
  prepareForInput("e");
  const tail = state.expression.split(/[+\-*/^()]/).pop() || "";
  if(!tail || /[eE]/.test(tail) || !/\d$/.test(tail)) return;
  state.expression += "e";
  render();
}

function addFunction(name){
  prepareForInput(name);
  state.expression += name + "(";
  render();
}

function closeOpenParentheses(){
  const balance = parenthesisBalance(state.expression);
  if(balance > 0) state.expression += ")".repeat(balance);
}

function parenthesisBalance(expression){
  let balance = 0;
  for(const char of String(expression)){
    if(char === "(") balance++;
    if(char === ")") balance--;
  }
  return balance;
}

function memoryValue(){
  if(!state.expression) return Number(state.answer) || 0;
  try{
    return calculateValue(state.expression,{allowRandom:true});
  }catch(error){
    setMessage(formatError(error),"error",2800);
    return null;
  }
}

function toggleActiveSign(){
  if(state.justEvaluated){
    state.expression = fmt(state.answer);
    state.justEvaluated = false;
    state.lastExpression = "";
  }

  let source = state.expression.trimEnd();
  if(!source){
    state.expression = "-";
    render();
    return;
  }

  let depth = 0;
  let start = 0;

  for(let i=source.length-1;i>=0;i--){
    const char = source[i];
    if(char === ")") depth++;
    else if(char === "(") depth--;
    else if(depth === 0 && "+-*/".includes(char)){
      const prev = source[i-1] || "";
      const isExponentSign = (char === "+" || char === "-") && /[eE]/.test(prev);
      const before = source.slice(0,i).trimEnd();
      const unary = !before || "+-*/^(".includes(before.slice(-1));
      if(!isExponentSign && !unary){
        start = i + 1;
        break;
      }
    }
  }

  const prefix = source.slice(0,start);
  const segment = source.slice(start).trim();

  if(!segment){
    state.expression = source + "-";
  }else if(segment.startsWith("(-") && segment.endsWith(")") && wrapsWholeGroup(segment)){
    state.expression = prefix + segment.slice(2,-1);
  }else if(segment.startsWith("-(") && segment.endsWith(")") && wrapsWholeGroup(segment.slice(1))){
    state.expression = prefix + segment.slice(2,-1);
  }else if(/^-(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?(?:[%!]*)$/i.test(segment)){
    state.expression = prefix + segment.slice(1);
  }else if(prefix){
    state.expression = prefix + "(-" + segment + ")";
  }else{
    state.expression = "-(" + segment + ")";
  }

  render();
}

function wrapsWholeGroup(segment){
  if(!segment.startsWith("(") || !segment.endsWith(")")) return false;
  let depth = 0;
  for(let i=0;i<segment.length;i++){
    if(segment[i] === "(") depth++;
    if(segment[i] === ")") depth--;
    if(depth === 0 && i < segment.length-1) return false;
  }
  return depth === 0;
}

function press(raw){
  vibrate();
  let key = raw;

  if(state.shift && SHIFT[key]){
    key = SHIFT[key];
    state.shift = false;
  }

  if(["MC","MR","MS","M+","M-"].includes(key)){
    if(key === "MC"){
      state.memory = 0;
      setMessage("Memory cleared","",1400);
    }
    if(key === "MR"){
      prepareForInput("mem");
      append("mem");
      return;
    }
    if(key === "MS"){
      const value = memoryValue();
      if(value === null) return;
      state.memory = value;
      setMessage("Saved to memory","",1400);
    }
    if(key === "M+"){
      const value = memoryValue();
      if(value === null) return;
      state.memory += value;
      setMessage("Added to memory","",1400);
    }
    if(key === "M-"){
      const value = memoryValue();
      if(value === null) return;
      state.memory -= value;
      setMessage("Subtracted from memory","",1400);
    }
    render();
    return;
  }

  if(key === "AC"){
    state.expression = "";
    state.lastExpression = "";
    state.justEvaluated = false;
    state.shift = false;
    setMessage("Expression cleared · Ans retained","",1700);
    render();
    return;
  }

  if(key === "⌫"){
    if(state.justEvaluated){
      state.justEvaluated = false;
      state.lastExpression = "";
    }
    state.expression = state.expression.slice(0,-1);
    render();
    return;
  }

  if(key === "="){
    closeOpenParentheses();
    evaluate();
    return;
  }

  if(key === "SHIFT"){
    state.shift = !state.shift;
    render();
    return;
  }

  if(key === "DEG/RAD"){
    state.angleMode = state.angleMode === "DEG" ? "RAD" : "DEG";
    setMessage("Angle mode: " + state.angleMode,"",1500);
    render();
    return;
  }

  if(key === "Ans") return append("ans");
  if(key === "π") return append("pi");
  if(key === "e") return append("e");
  if(key === "rand") return append("rand");
  if(key === "EXP") return appendExponent();
  if(key === "√") return addFunction("sqrt");
  if(key === "∛") return addFunction("cbrt");
  if(key === "x²") return append("^2");
  if(key === "x³") return append("^3");
  if(key === "1/x") return addFunction("reciprocal");
  if(key === "|x|") return addFunction("abs");
  if(key === "eˣ") return addFunction("exp");
  if(key === "10ˣ") return addFunction("pow10");
  if(["sin","cos","tan","asin","acos","atan","ln","log"].includes(key)) return addFunction(key);
  if(key === "±") return toggleActiveSign();

  if(key === "×") key = "*";
  if(key === "÷") key = "/";
  if(key === "−") key = "-";

  append(key);
}

function keyClass(key){
  if(key === "=") return "key equals";
  if(key === "AC") return "key danger";
  if(["MC","MR","MS","M+","M-"].includes(key)) return "key memory";
  if(["+","−","×","÷","^","√","∛"].includes(key)) return "key operator";
  if(["⌫","±","SHIFT","DEG/RAD"].includes(key)) return "key control";
  if(["sin","cos","tan","asin","acos","atan","ln","log","x²","x³","1/x","|x|","rand","EXP","!"].includes(key)){
    return "key function";
  }
  return "key";
}

function makeKey(key,container){
  const button = document.createElement("button");
  button.type = "button";
  button.dataset.key = key;
  button.className = keyClass(key);
  button.setAttribute("aria-label",LABELS[key] || key);
  button.title = LABELS[key] || key;

  if(key === "0") button.classList.add("zero");

  if(SHIFT[key]){
    const secondary = document.createElement("small");
    secondary.textContent = SHIFT[key];
    button.appendChild(secondary);
  }

  const label = document.createElement("span");
  label.textContent = key;
  button.appendChild(label);

  button.addEventListener("click",()=>press(key));
  container.appendChild(button);
}

function buildKeys(){
  $("keys").innerHTML = "";
  PRIMARY.flat().forEach(key=>makeKey(key,$("keys")));
  $("secondaryKeys").innerHTML = "";
  SECONDARY.forEach(key=>makeKey(key,$("secondaryKeys")));
}

function previewExpression(){
  const expression = state.expression.trim();
  if(!expression){
    previewCache = {ok:true,value:Number(state.answer)||0,error:null};
    return previewCache;
  }

  if(/\brand\b/i.test(expression)){
    previewCache = {ok:false,value:0,error:"Press = to generate a random value",random:true};
    return previewCache;
  }

  try{
    const value = calculateValue(expression,{allowRandom:false});
    previewCache = {ok:true,value,error:null};
  }catch(error){
    previewCache = {ok:false,value:0,error:formatError(error)};
  }
  return previewCache;
}

function renderHistory(){
  const list = $("historyList");
  list.innerHTML = "";

  if(!state.history.length){
    const empty = document.createElement("div");
    empty.className = "history-empty";
    empty.innerHTML = "Your calculations will appear here.<br>Everything stays on this device.";
    list.appendChild(empty);
    return;
  }

  state.history.forEach((item,index)=>{
    const card = document.createElement("article");
    card.className = "history-item";

    const expression = document.createElement("div");
    expression.className = "history-expression";
    expression.textContent = pretty(item.expression);

    const result = document.createElement("div");
    result.className = "history-result";
    result.textContent = item.result;

    card.append(expression,result);

    if(item.time){
      const time = document.createElement("div");
      time.className = "history-time";
      const date = new Date(item.time);
      time.textContent = Number.isNaN(date.getTime()) ? "" : date.toLocaleString();
      card.appendChild(time);
    }

    const actions = document.createElement("div");
    actions.className = "history-actions";

    const actionData = [
      ["Reuse",()=>{
        state.expression = item.result;
        state.justEvaluated = false;
        state.lastExpression = "";
        render();
      }],
      ["Edit",()=>{
        state.expression = item.expression;
        state.justEvaluated = false;
        state.lastExpression = "";
        render();
      }],
      ["Delete",()=>{
        state.history.splice(index,1);
        render();
      }]
    ];

    actionData.forEach(([text,handler])=>{
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = text;
      button.addEventListener("click",handler);
      actions.appendChild(button);
    });

    card.appendChild(actions);
    list.appendChild(card);
  });
}

function queueExpressionScroll(){
  if(renderQueued) return;
  renderQueued = true;
  requestAnimationFrame(()=>{
    renderQueued = false;
    $("expr").scrollLeft = $("expr").scrollWidth;
  });
}

function render(){
  const preview = previewExpression();
  const expressionText = state.justEvaluated && state.lastExpression
    ? pretty(state.lastExpression) + " ="
    : pretty(state.expression);

  $("expr").textContent = expressionText;
  $("expressionInput").value = state.expression;

  if(state.justEvaluated){
    $("disp").textContent = fmt(state.answer);
    $("previewNote").textContent = "Result";
  }else if(state.expression){
    $("disp").textContent = preview.ok ? fmt(preview.value) : "…";
    $("previewNote").textContent = preview.ok ? "Live preview" : (preview.random ? preview.error : "");
  }else{
    $("disp").textContent = fmt(state.answer || 0);
    $("previewNote").textContent = state.answer ? "Previous answer" : "";
  }

  $("angleStatus").textContent = state.angleMode;
  $("memoryDot").classList.toggle("on",state.memory !== 0);
  $("shiftDot").classList.toggle("on",state.shift);
  $("parenStatus").textContent = "PAREN " + Math.max(0,parenthesisBalance(state.expression));

  $("themeBtn").textContent = state.theme === "dark" ? "Light" : "Dark";
  $("hapticBtn").textContent = state.haptic ? "Haptic On" : "Haptic Off";

  document.documentElement.dataset.theme = state.theme;
  document.querySelector('meta[name="theme-color"]').setAttribute(
    "content",
    state.theme === "dark" ? "#11151c" : "#f3efe7"
  );

  document.querySelectorAll("[data-key]").forEach(button=>{
    const key = button.dataset.key;
    const label = button.querySelector("span");
    if(label && SHIFT[key]) label.textContent = state.shift ? SHIFT[key] : key;
    button.classList.toggle("pressed",key === "SHIFT" && state.shift);
    button.setAttribute("aria-pressed",key === "SHIFT" ? String(state.shift) : "false");
  });

  renderHistory();
  save();
  queueExpressionScroll();
}

async function copyText(text){
  if(navigator.clipboard && window.isSecureContext){
    await navigator.clipboard.writeText(text);
    return true;
  }

  const area = document.createElement("textarea");
  area.value = text;
  area.style.position = "fixed";
  area.style.opacity = "0";
  document.body.appendChild(area);
  area.focus();
  area.select();

  let success = false;
  try{ success = document.execCommand("copy"); }catch{}
  area.remove();
  return success;
}

function openDrawer(){
  document.body.classList.add("drawer-open");
  $("historyToggle").setAttribute("aria-expanded","true");
  if(window.innerWidth > 900){
    $("historyDrawer").scrollIntoView({behavior:"smooth",block:"start"});
  }else{
    setTimeout(()=>$("drawerCloseBtn").focus(),80);
  }
}

function closeDrawer(){
  document.body.classList.remove("drawer-open");
  $("historyToggle").setAttribute("aria-expanded","false");
}

function exportData(){
  const payload = {
    app:"Khaemenes Scientific Calculator",
    version:4,
    exportedAt:new Date().toISOString(),
    state:sanitizeState(state)
  };
  const blob = new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
  const url = URL.createObjectURL(blob);
  const anchor = document.createElement("a");
  anchor.href = url;
  anchor.download = "khaemenes-calculator-v4-backup.json";
  document.body.appendChild(anchor);
  anchor.click();
  anchor.remove();
  URL.revokeObjectURL(url);
  toast("Backup exported");
}

async function importData(file){
  try{
    const text = await file.text();
    const parsed = JSON.parse(text);
    const importedState = parsed && parsed.state ? parsed.state : parsed;
    state = sanitizeState(importedState);
    render();
    toast("Backup imported");
  }catch{
    toast("Could not import that file");
  }finally{
    $("importFile").value = "";
  }
}

function historyAsText(){
  if(!state.history.length) return "No saved calculations.";
  return state.history.map(item=>`${pretty(item.expression)} = ${item.result}`).join("\n");
}

$("expressionInput").addEventListener("input",event=>{
  state.expression = event.target.value;
  state.justEvaluated = false;
  state.lastExpression = "";
  render();
});

$("expressionInput").addEventListener("keydown",event=>{
  if(event.key === "Enter"){
    event.preventDefault();
    closeOpenParentheses();
    evaluate();
  }
});

$("themeBtn").addEventListener("click",()=>{
  state.theme = state.theme === "dark" ? "light" : "dark";
  render();
});

$("hapticBtn").addEventListener("click",()=>{
  state.haptic = !state.haptic;
  if(state.haptic) vibrate(12);
  render();
});

$("historyToggle").addEventListener("click",openDrawer);
$("drawerCloseBtn").addEventListener("click",closeDrawer);
$("drawerOverlay").addEventListener("click",closeDrawer);

$("clearHistoryBtn").addEventListener("click",()=>{
  if(state.history.length && confirm("Clear calculator history on this device?")){
    state.history = [];
    render();
  }
});

$("copyBtn").addEventListener("click",async()=>{
  const value = state.justEvaluated
    ? fmt(state.answer)
    : (previewCache.ok ? fmt(previewCache.value) : fmt(state.answer || 0));

  try{
    const success = await copyText(value);
    toast(success ? "Result copied" : "Copy was not available");
  }catch{
    toast("Copy failed");
  }
});

$("exportBtn").addEventListener("click",exportData);
$("importBtn").addEventListener("click",()=>$("importFile").click());
$("importFile").addEventListener("change",event=>{
  const file = event.target.files && event.target.files[0];
  if(file) importData(file);
});

$("copyHistoryBtn").addEventListener("click",async()=>{
  try{
    const success = await copyText(historyAsText());
    toast(success ? "History copied" : "Copy was not available");
  }catch{
    toast("Copy failed");
  }
});

$("resetAllBtn").addEventListener("click",()=>{
  if(confirm("Reset expression, answer, memory, history, and preferences?")){
    state = fresh();
    render();
    closeDrawer();
    toast("Calculator reset");
  }
});

document.addEventListener("keydown",event=>{
  if(event.target === $("expressionInput")) return;

  const map = {
    "+":"+","-":"−","*":"×","/":"÷","^":"^","(":"(",")":")","%":"%","!":"!"
  };

  if(/^[0-9.]$/.test(event.key)){
    press(event.key);
    event.preventDefault();
  }else if(map[event.key]){
    press(map[event.key]);
    event.preventDefault();
  }else if(event.key === "Enter" || event.key === "="){
    press("=");
    event.preventDefault();
  }else if(event.key === "Backspace"){
    press("⌫");
    event.preventDefault();
  }else if(event.key === "Escape"){
    if(document.body.classList.contains("drawer-open")) closeDrawer();
    else press("AC");
    event.preventDefault();
  }else if(event.key.toLowerCase() === "d"){
    press("DEG/RAD");
    event.preventDefault();
  }
});

buildKeys();
render();
})();
</script>
</body>
