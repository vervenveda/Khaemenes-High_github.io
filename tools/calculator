<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Khaemenes Scientific Calculator — safe offline scientific computation with degree and radian modes, memory, history, constants, functions, and keyboard support.">
<meta name="theme-color" content="#11151c">
<title>Khaemenes Scientific Calculator</title>
<style>
:root{--bg:#0e1117;--bg2:#151a22;--panel:#202630;--panel2:#2a313d;--screen:#090c11;--ink:#f4f6f8;--muted:#9ca7b4;--gold:#c9b06b;--gold2:#e2ca8b;--blue:#58697f;--danger:#9f4652;--line:rgba(255,255,255,.09);--shadow:0 24px 70px rgba(0,0,0,.48)}
html[data-theme="light"]{--bg:#e9e5dc;--bg2:#f3efe7;--panel:#fbfaf6;--panel2:#eee8dc;--screen:#fff;--ink:#17232d;--muted:#697581;--blue:#cbd6e1;--line:rgba(23,35,45,.12);--shadow:0 24px 65px rgba(48,41,31,.18)}
*{box-sizing:border-box}body{margin:0;min-height:100vh;padding:18px 10px 42px;color:var(--ink);font-family:Inter,system-ui,sans-serif;background:radial-gradient(circle at 15% 8%,rgba(201,176,107,.08),transparent 24%),linear-gradient(145deg,var(--bg),var(--bg2))}
button,input,select{font:inherit}button{cursor:pointer;touch-action:manipulation}:focus-visible{outline:3px solid rgba(201,176,107,.38);outline-offset:3px}
.app-shell{width:min(1180px,100%);margin:auto}.site-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px;padding:11px 13px;border:1px solid var(--line);border-radius:17px;background:rgba(32,38,48,.76);backdrop-filter:blur(14px)}
html[data-theme="light"] .site-head{background:rgba(251,250,246,.84)}.brand{display:flex;align-items:center;gap:11px;min-width:0}.brand-mark{width:48px;height:48px;display:grid;place-items:center;border:1px solid rgba(201,176,107,.55);border-radius:13px;color:var(--gold2);font-family:Georgia,serif;letter-spacing:.08em}
.brand-copy strong{display:block;font-family:Georgia,serif;font-size:1rem;letter-spacing:.06em;text-transform:uppercase}.brand-copy small{display:block;margin-top:2px;color:var(--muted);font-size:.72rem}.head-actions{display:flex;gap:7px}.icon-btn{min-height:40px;padding:8px 11px;border:1px solid var(--line);border-radius:11px;background:var(--panel);color:var(--ink);font-weight:800}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:14px;align-items:start}.calc,.drawer{border:1px solid var(--line);border-radius:21px;background:linear-gradient(145deg,var(--panel),var(--panel2));box-shadow:var(--shadow)}.calc{min-width:0;padding:17px}.drawer{position:sticky;top:18px;padding:15px}
.top{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:28px;color:var(--gold2);font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.status-group{display:flex;gap:10px;flex-wrap:wrap}.status-chip{display:inline-flex;align-items:center;gap:5px}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--muted)}.status-dot.on{background:var(--gold)}
.screen{min-height:154px;margin:10px 0 13px;padding:14px;border:1px solid rgba(201,176,107,.22);border-radius:16px;background:var(--screen);overflow:hidden}#expr{min-height:31px;color:var(--muted);text-align:right;font-size:1rem;line-height:1.45;overflow-wrap:anywhere}#disp{min-height:60px;margin-top:5px;text-align:right;font-family:Consolas,monospace;font-size:clamp(2.25rem,7vw,4.35rem);line-height:1.1;letter-spacing:-.045em;overflow-wrap:anywhere}
.screen-meta{display:flex;justify-content:space-between;gap:12px;margin-top:11px;color:var(--muted);font-size:.7rem}.screen-message{min-height:1.2em;color:var(--gold2)}.copy-result,.clear-history{border:0;background:transparent;color:var(--muted);font-size:.7rem}.mobile-expression{display:none;width:100%;margin-bottom:10px;padding:11px 12px;border:1px solid var(--line);border-radius:12px;background:var(--screen);color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}.key{position:relative;min-width:0;height:56px;padding:7px 5px;border:1px solid rgba(255,255,255,.035);border-radius:12px;background:#343b46;color:#fff;font-size:1rem;font-weight:760;box-shadow:inset 0 1px rgba(255,255,255,.05),0 3px 8px rgba(0,0,0,.16);transition:.1s}
html[data-theme="light"] .key{border-color:rgba(23,35,45,.09);background:#f5f2ec;color:#17232d}.key:hover{filter:brightness(1.08)}.key:active,.key.pressed{transform:translateY(2px) scale(.985)}.key small{position:absolute;top:4px;left:6px;color:#d6c58f;font-size:.53rem}.key.function{background:#2b333e}.key.operator{background:var(--blue)}.key.control{background:#4a3f46}.key.memory{background:#2f363f;color:#e5d49d}.key.equals{background:linear-gradient(145deg,var(--gold2),var(--gold));color:#141414;font-weight:950}.key.danger{background:var(--danger)}.key.zero{grid-column:span 2}
.secondary-strip{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:8px}.secondary-strip .key{height:46px;font-size:.82rem}.drawer-head{display:flex;justify-content:space-between;align-items:center;gap:8px;padding-bottom:11px;border-bottom:1px solid var(--line)}.drawer h2{margin:0;color:var(--gold2);font-family:Georgia,serif;font-size:1.08rem}
.history{display:grid;gap:8px;max-height:445px;margin-top:11px;overflow:auto}.history-item{padding:10px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.025)}.history-expression{color:var(--muted);font: .72rem/1.4 Consolas,monospace;overflow-wrap:anywhere}.history-result{margin-top:4px;font:800 1rem Consolas,monospace;overflow-wrap:anywhere}.history-actions{display:flex;gap:6px;margin-top:7px}.history-actions button{flex:1;padding:6px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--muted);font-size:.68rem}.history-empty{padding:22px 8px;color:var(--muted);text-align:center;font-size:.8rem;line-height:1.5}
.help{margin-top:13px;padding-top:13px;border-top:1px solid var(--line)}.help summary{cursor:pointer;color:var(--gold2);font-size:.82rem;font-weight:850}.help-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}.help-grid div{padding:8px;border-radius:9px;background:rgba(255,255,255,.025);color:var(--muted);font-size:.68rem;line-height:1.45}.footer-note{margin-top:13px;color:var(--muted);text-align:center;font-size:.72rem;line-height:1.5}
.toast{position:fixed;left:50%;bottom:20px;transform:translate(-50%,26px);padding:9px 14px;border-radius:999px;background:#07090c;color:#fff;font-size:.78rem;font-weight:800;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:900px){.layout{grid-template-columns:1fr}.drawer{position:static}}@media(max-width:620px){body{padding:8px 5px 28px}.calc{padding:10px;border-radius:15px}.grid,.secondary-strip{gap:5px}.key{height:50px;border-radius:9px;font-size:.9rem}.secondary-strip .key{height:43px}.mobile-expression{display:block}.top{font-size:.6rem}.brand-copy small{display:none}}@media(max-width:430px){.brand-copy strong{font-size:.78rem}.brand-mark{width:42px;height:42px}.head-actions .icon-btn:first-child{display:none}.key{height:48px;font-size:.82rem}.key small{display:none}}
</style>
</head>
<body>
<div class="app-shell">
<header class="site-head"><div class="brand"><div class="brand-mark">KA</div><div class="brand-copy"><strong>Khaemenes Scientific Calculator</strong><small>Verve N Veda Tools · Safe local computation</small></div></div><div class="head-actions"><button class="icon-btn" id="historyToggle">History</button><button class="icon-btn" id="themeBtn">Light</button></div></header>
<main class="layout">
<section class="calc" aria-label="Scientific calculator">
<div class="top"><div class="status-group"><span class="status-chip"><span class="status-dot on"></span><span id="angleStatus">DEG</span></span><span class="status-chip"><span class="status-dot" id="memoryDot"></span>M</span><span class="status-chip"><span class="status-dot" id="shiftDot"></span>SHIFT</span></div><span>12 DIGITS</span></div>
<div class="screen" aria-live="polite"><div id="expr"></div><div id="disp">0</div><div class="screen-meta"><span class="screen-message" id="message"></span><button class="copy-result" id="copyBtn">Copy result</button></div></div>
<input class="mobile-expression" id="expressionInput" autocomplete="off" spellcheck="false" aria-label="Calculator expression">
<div class="grid" id="keys"></div><div class="secondary-strip" id="secondaryKeys"></div>
<div class="footer-note">Keyboard: numbers/operators · Enter evaluates · Backspace deletes · Escape clears · D toggles DEG/RAD</div>
</section>
<aside class="drawer" id="historyDrawer"><div class="drawer-head"><h2>Calculation History</h2><button class="clear-history" id="clearHistoryBtn">Clear</button></div><div class="history" id="historyList"></div><details class="help"><summary>Functions and keyboard help</summary><div class="help-grid"><div><strong>Angles</strong><br>DEG or RAD affects trigonometry.</div><div><strong>Percent</strong><br>50% becomes 0.5.</div><div><strong>Constants</strong><br>π, e, Ans, random, and memory.</div><div><strong>Safety</strong><br>No eval or Function execution.</div></div></details></aside>
</main></div><div class="toast" id="toast"></div>
<script>
(() => {
"use strict";
const $=id=>document.getElementById(id);
const KEY="khaemenes-scientific-calculator-v3";
const PRIMARY=[["MC","MR","MS","M+","M-","AC"],["("," )","⌫","÷","√","^"],["7","8","9","×","π","Ans"],["4","5","6","−","x²","%"],["1","2","3","+","±","="],["0",".","EXP","sin","cos","tan"]];
const SECONDARY=["SHIFT","DEG/RAD","ln","log","e","!","asin","acos","atan","1/x","|x|","rand"];
const SHIFT={"sin":"asin","cos":"acos","tan":"atan","√":"∛","x²":"x³","ln":"eˣ","log":"10ˣ"};
const fresh=()=>({expression:"",answer:0,memory:0,angleMode:"DEG",shift:false,history:[],theme:"dark"});
function load(){try{return Object.assign(fresh(),JSON.parse(localStorage.getItem(KEY)||"{}"))}catch{return fresh()}}
let state=load();
function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch{}}
function toast(t){$("toast").textContent=t;$("toast").classList.add("show");clearTimeout(toast.t);toast.t=setTimeout(()=>$("toast").classList.remove("show"),1500)}
function fmt(v){if(!Number.isFinite(v))return String(v);if(Object.is(v,-0))v=0;const a=Math.abs(v);if((a&&a<1e-9)||a>=1e12)return v.toExponential(10).replace(/\.?0+e/,"e");return Number(v.toPrecision(12)).toString()}
function pretty(s){return s.replaceAll("*","×").replaceAll("/","÷").replaceAll("-","−").replace(/\bpi\b/g,"π").replace(/\bsqrt\b/g,"√").replace(/\bcbrt\b/g,"∛")}
function msg(t,ms=1800){$("message").textContent=t;clearTimeout(msg.t);if(ms)msg.t=setTimeout(()=>$("message").textContent="",ms)}
function rad(x){return state.angleMode==="DEG"?x*Math.PI/180:x}function unrad(x){return state.angleMode==="DEG"?x*180/Math.PI:x}
function fact(n){if(!Number.isInteger(n)||n<0)throw Error("Factorial needs a non-negative integer");if(n>170)throw Error("Factorial is too large");let r=1;for(let i=2;i<=n;i++)r*=i;return r}
const F={sin:x=>Math.sin(rad(x)),cos:x=>Math.cos(rad(x)),tan:x=>{const r=rad(x);if(Math.abs(Math.cos(r))<1e-14)throw Error("Tangent is undefined");return Math.tan(r)},asin:x=>unrad(Math.asin(x)),acos:x=>unrad(Math.acos(x)),atan:x=>unrad(Math.atan(x)),sqrt:x=>{if(x<0)throw Error("Square root needs a non-negative number");return Math.sqrt(x)},cbrt:x=>Math.cbrt(x),ln:x=>{if(x<=0)throw Error("Natural log needs a positive number");return Math.log(x)},log:x=>{if(x<=0)throw Error("Log needs a positive number");return Math.log10(x)},abs:x=>Math.abs(x),exp:x=>Math.exp(x),pow10:x=>10**x,reciprocal:x=>{if(!x)throw Error("Cannot divide by zero");return 1/x}};
function tokens(input){const a=[];let i=0;while(i<input.length){const c=input[i];if(/\s/.test(c)){i++;continue}if(/[0-9.]/.test(c)){let n="",dots=0;while(i<input.length&&/[0-9.eE+-]/.test(input[i])){const q=input[i];if(q==="."){if(++dots>1)break}if((q==="+"||q==="-")&&!/[eE]$/.test(n))break;n+=q;i++}if(!/^(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?$/.test(n))throw Error("Invalid number");a.push({t:"n",v:+n});continue}if(/[A-Za-z_π]/.test(c)){let w="";if(c==="π"){w="pi";i++}else while(i<input.length&&/[A-Za-z_0-9]/.test(input[i]))w+=input[i++];a.push({t:"w",v:w.toLowerCase()});continue}if("+-*/^(),%!".includes(c)){a.push({t:"s",v:c});i++;continue}throw Error("Unsupported character: "+c)}return a}
function parse(input){const t=tokens(input);let p=0;const peek=v=>t[p]&&(v===undefined||t[p].v===v);const eat=v=>{if(!t[p]||(v!==undefined&&t[p].v!==v))throw Error(v?"Expected "+v:"Incomplete expression");return t[p++]};
function post(v){while(peek("!")||peek("%")){if(peek("!")){eat("!");v=fact(v)}else{eat("%");v/=100}}return v}
function primary(){if(peek("+")){eat("+");return primary()}if(peek("-")){eat("-");return-primary()}if(peek("(")){eat("(");const v=add();eat(")");return post(v)}const x=t[p];if(!x)throw Error("Incomplete expression");if(x.t==="n"){p++;return post(x.v)}if(x.t==="w"){p++;const n=x.v;if(n==="pi")return post(Math.PI);if(n==="e")return post(Math.E);if(n==="ans")return post(+state.answer||0);if(n==="mem")return post(+state.memory||0);if(n==="rand")return post(Math.random());if(F[n]){eat("(");const v=add();eat(")");return post(F[n](v))}throw Error("Unknown function: "+n)}throw Error("Expected a number or function")}
function power(){let v=primary();if(peek("^")){eat("^");v=Math.pow(v,power())}return v}
function implicit(){const x=t[p];return x&&(x.t==="n"||x.t==="w"||x.v==="(")}
function mul(){let v=power();for(;;){if(peek("*")){eat("*");v*=power()}else if(peek("/")){eat("/");const d=power();if(!d)throw Error("Cannot divide by zero");v/=d}else if(implicit())v*=power();else break}return v}
function add(){let v=mul();while(peek("+")||peek("-")){if(peek("+")){eat("+");v+=mul()}else{eat("-");v-=mul()}}return v}
const r=add();if(p<t.length)throw Error("Unexpected token: "+t[p].v);return r}
function norm(s){return s.replaceAll("×","*").replaceAll("÷","/").replaceAll("−","-").replaceAll("π","pi").replaceAll("√","sqrt").replaceAll("∛","cbrt")}
function evaluate(expression=state.expression,history=true){const source=norm(expression.trim());if(!source)return state.answer||0;try{const r=parse(source);if(!Number.isFinite(r))throw Error("Result is outside calculator range");const original=expression;state.answer=r;state.expression=fmt(r);if(history){state.history.unshift({expression:original,result:fmt(r)});state.history=state.history.slice(0,40)}msg("Calculated");render();return r}catch(e){msg(e.message||"Invalid expression",2600);$("disp").textContent="Error";return null}}
function append(v){const ops=["+","-","*","/","^"],last=state.expression.slice(-1);state.expression=ops.includes(v)&&ops.includes(last)?state.expression.slice(0,-1)+v:state.expression+v;render()}
function fn(n){state.expression+=n+"(";render()}function closes(){let n=0;for(const c of state.expression){if(c==="(")n++;if(c===")")n--}if(n>0)state.expression+=")".repeat(n)}
function memoryValue(){const v=state.expression?evaluate(state.expression,false):state.answer;return v===null?0:+v}
function press(raw){let k=raw;if(state.shift&&SHIFT[k]){k=SHIFT[k];state.shift=false}if(["MC","MR","MS","M+","M-"].includes(k)){if(k==="MC"){state.memory=0;msg("Memory cleared")}if(k==="MR"){append(fmt(state.memory));return}if(k==="MS"){state.memory=memoryValue();msg("Saved to memory")}if(k==="M+"){state.memory+=memoryValue();msg("Added to memory")}if(k==="M-"){state.memory-=memoryValue();msg("Subtracted from memory")}render();return}
if(k==="AC"){state.expression="";state.answer=0;msg("Cleared");render();return}if(k==="⌫"){state.expression=state.expression.slice(0,-1);render();return}if(k==="="){closes();evaluate();return}if(k==="SHIFT"){state.shift=!state.shift;render();return}if(k==="DEG/RAD"){state.angleMode=state.angleMode==="DEG"?"RAD":"DEG";msg("Angle mode: "+state.angleMode);render();return}
if(k==="Ans")return append("ans");if(k==="π")return append("pi");if(k==="e")return append("e");if(k==="rand")return append("rand");if(k==="EXP")return append("e");if(k==="√")return fn("sqrt");if(k==="∛")return fn("cbrt");if(k==="x²")return append("^2");if(k==="x³")return append("^3");if(k==="1/x")return fn("reciprocal");if(k==="|x|")return fn("abs");if(k==="eˣ")return fn("exp");if(k==="10ˣ")return fn("pow10");if(["sin","cos","tan","asin","acos","atan","ln","log"].includes(k))return fn(k);if(k==="±"){state.expression=state.expression?"-("+state.expression+")":"-";render();return}if(k==="×")k="*";if(k==="÷")k="/";if(k==="−")k="-";if(k===" )")k=")";append(k)}
function klass(k){if(k==="=")return"key equals";if(k==="AC")return"key danger";if(["MC","MR","MS","M+","M-"].includes(k))return"key memory";if(["+","−","×","÷","^","√","∛"].includes(k))return"key operator";if(["⌫","±","SHIFT","DEG/RAD"].includes(k))return"key control";if(["sin","cos","tan","asin","acos","atan","ln","log","x²","x³","1/x","|x|","rand","EXP","!"].includes(k))return"key function";return"key"}
function make(k,box){const b=document.createElement("button");b.type="button";b.dataset.key=k;b.className=klass(k);if(k==="0")b.classList.add("zero");if(SHIFT[k]){const s=document.createElement("small");s.textContent=SHIFT[k];b.appendChild(s)}const l=document.createElement("span");l.textContent=k;b.appendChild(l);b.onclick=()=>press(k);box.appendChild(b)}
function build(){$("keys").innerHTML="";PRIMARY.flat().forEach(k=>make(k,$("keys")));$("secondaryKeys").innerHTML="";SECONDARY.forEach(k=>make(k,$("secondaryKeys")))}
function renderHistory(){const l=$("historyList");l.innerHTML="";if(!state.history.length){l.innerHTML='<div class="history-empty">Your calculations will appear here.<br>Everything stays on this device.</div>';return}state.history.forEach((x,i)=>{const c=document.createElement("article");c.className="history-item";c.innerHTML=`<div class="history-expression">${pretty(x.expression)}</div><div class="history-result">${x.result}</div>`;const a=document.createElement("div");a.className="history-actions";[["Reuse",()=>{state.expression=x.result;render()}],["Edit",()=>{state.expression=x.expression;render()}],["Delete",()=>{state.history.splice(i,1);render()}]].forEach(([t,f])=>{const b=document.createElement("button");b.textContent=t;b.onclick=f;a.appendChild(b)});c.appendChild(a);l.appendChild(c)})}
function render(){$("expr").textContent=pretty(state.expression);$("expressionInput").value=state.expression;$("disp").textContent=state.expression?pretty(state.expression):fmt(state.answer||0);$("angleStatus").textContent=state.angleMode;$("memoryDot").classList.toggle("on",state.memory!==0);$("shiftDot").classList.toggle("on",state.shift);$("themeBtn").textContent=state.theme==="dark"?"Light":"Dark";document.documentElement.dataset.theme=state.theme;document.querySelectorAll("[data-key]").forEach(b=>{const k=b.dataset.key,l=b.querySelector("span");if(l&&SHIFT[k])l.textContent=state.shift?SHIFT[k]:k;b.classList.toggle("pressed",k==="SHIFT"&&state.shift)});renderHistory();save()}
$("expressionInput").oninput=e=>{state.expression=e.target.value;render()};$("expressionInput").onkeydown=e=>{if(e.key==="Enter"){e.preventDefault();closes();evaluate()}};$("themeBtn").onclick=()=>{state.theme=state.theme==="dark"?"light":"dark";render()};$("historyToggle").onclick=()=>$("historyDrawer").scrollIntoView({behavior:"smooth"});$("clearHistoryBtn").onclick=()=>{if(state.history.length&&confirm("Clear calculator history on this device?")){state.history=[];render()}};
$("copyBtn").onclick=async()=>{const v=fmt(state.answer||0);try{await navigator.clipboard.writeText(v)}catch{}toast("Result copied")};
document.addEventListener("keydown",e=>{if(e.target===$("expressionInput"))return;const map={"+":"+","-":"−","*":"×","/":"÷","^":"^","(":"(",")":" )","%":"%","!":"!"};if(/^[0-9.]$/.test(e.key)){press(e.key);e.preventDefault()}else if(map[e.key]){press(map[e.key]);e.preventDefault()}else if(e.key==="Enter"||e.key==="="){press("=");e.preventDefault()}else if(e.key==="Backspace"){press("⌫");e.preventDefault()}else if(e.key==="Escape"){press("AC");e.preventDefault()}else if(e.key.toLowerCase()==="d"){press("DEG/RAD");e.preventDefault()}});
build();render();
})();
</script>
</body></html>
